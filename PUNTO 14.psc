Algoritmo costo_carro
	definir precio, ganancia, impuesto, costo_total Como Real
	precio = 35000000
	ganancia = 0.12
	impuesto = 0.06
	ganancia = (precio* ganancia)
	impuesto = (precio* impuesto)
	costo_total =  precio+ ganancia + impuesto
	Escribir 'el precio del vehiculo es:', precio
	Escribir 'la ganancia del vendedor es de :', ganancia
	Escribir 'el impuesto del vehiculo es:', impuesto
	Escribir 'elcosto toal es de:', costo_total
FinAlgoritmo