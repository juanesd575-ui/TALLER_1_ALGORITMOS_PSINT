Algoritmo area_triangulo
	Definir base, altura, area Como Real
	Escribir 'vamos a calcular el area de un triangulo'
	Escribir 'porfavor digita la base en numeros'
	Leer base
	Escribir 'porfavor digita la altura en numeros'
	Leer altura
	area <- (base*altura)/2
	Escribir "el area es:",area
FinAlgoritmo